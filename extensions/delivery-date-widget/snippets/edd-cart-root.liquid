{% doc %}
Estimated delivery root for the cart page. Rendered by the app embed and the cart app block.
@param {string} [shopify_attributes] - Theme editor block attributes
{% enddoc %}
{% capture cart_items %}
[{% for item in cart.items %}{"id":"gid://shopify/Product/{{ item.product.id }}","title":{{ item.product.title | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
{% endcapture %}
<div
  class="edd-root"
  data-edd-root
  data-location="CART"
  data-cart-items="{{ cart_items | strip_newlines | escape }}"
  data-locale="{{ request.locale.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  data-market="{{ localization.market.handle }}"
  data-config-url="/apps/delivery-date/config"
  data-events-url="/apps/delivery-date/events"
  {{ shopify_attributes }}
></div>
