{% doc %}
Renders the estimated delivery date widget on the cart page.
{% enddoc %}

{% if app.metafields.app.embed_enabled.value != false %}
{% capture cart_items %}
[{% for item in cart.items %}{"id":"gid://shopify/Product/{{ item.product.id }}","title":{{ item.product.title | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
{% endcapture %}

<div
  class="edd-root"
  data-edd-root
  data-location="CART"
  data-cart-items="{{ cart_items | strip_newlines | escape }}"
  data-locale="{{ request.locale.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  data-market="{{ localization.market.handle }}"
  data-config-url="/apps/delivery-date/config"
  data-events-url="/apps/delivery-date/events"
  {{ block.shopify_attributes }}
></div>
{% endif %}

{% schema %}
{
  "name": "Cart estimated delivery",
  "target": "section",
  "stylesheet": "delivery-widget.css",
  "javascript": "delivery-widget.js",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows estimated delivery in the cart using the shared shipping rules from the Estimated Delivery Date app. The App Embed must be Active in the theme editor for this block to appear on the store."
    }
  ]
}
{% endschema %}
