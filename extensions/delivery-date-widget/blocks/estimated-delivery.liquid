{% doc %}
Renders the estimated delivery date widget on product pages.
@param {product} [product] - The current product
{% enddoc %}

{% render "edd-product-root", shopify_attributes: block.shopify_attributes, product: product %}

{% schema %}
{
  "name": "Estimated delivery",
  "target": "section",
  "stylesheet": "delivery-widget.css",
  "javascript": "delivery-widget.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows estimated delivery dates from the app. Saving Publish or Schedule in the app adds this block to the product page automatically."
    }
  ]
}
{% endschema %}
