{% doc %}
Estimated delivery root for the product page. Rendered by the app embed and the product app block.
@param {object} product - The current product
@param {string} [shopify_attributes] - Theme editor block attributes
{% enddoc %}
<div
  class="edd-root"
  data-edd-root
  data-location="PRODUCT"
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-product-name="{{ product.title | escape }}"
  data-stock-left="{{ product.selected_or_first_available_variant.inventory_quantity | default: '' }}"
  data-locale="{{ request.locale.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  data-market="{{ localization.market.handle }}"
  data-collection-ids="{% for collection in product.collections %}gid://shopify/Collection/{{ collection.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-config-url="/apps/delivery-date/config"
  data-events-url="/apps/delivery-date/events"
  {{ shopify_attributes }}
></div>
