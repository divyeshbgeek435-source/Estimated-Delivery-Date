{% doc %}
App embed that enables estimated delivery on the storefront and shows the widget once on product and cart pages.
{% enddoc %}

<script>
  fetch("/apps/delivery-date/embed-ping", { keepalive: true }).catch(function () {});
</script>

{% if template.name == "product" %}
  {% render "edd-product-root", shopify_attributes: block.shopify_attributes, product: product %}
{% elsif template.name == "cart" %}
  {% render "edd-cart-root", shopify_attributes: block.shopify_attributes %}
{% endif %}

{% schema %}
{
  "name": "Estimated delivery embed",
  "target": "body",
  "stylesheet": "delivery-widget.css",
  "javascript": "delivery-widget.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Activates estimated delivery. On product and cart pages this embed shows the published widget once. Checkout widgets use the checkout extension."
    }
  ]
}
{% endschema %}
