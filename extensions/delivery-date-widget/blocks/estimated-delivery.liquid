{% doc %}
Renders the estimated delivery date widget on product and collection pages only.
@param {product} [product] - The current product
@param {collection} [collection] - The current collection
{% enddoc %}

{% if product %}
  {% render "edd-product-root", shopify_attributes: block.shopify_attributes, product: product, collection: collection %}
{% elsif collection %}
  {% render "edd-product-root", shopify_attributes: block.shopify_attributes, collection: collection %}
{% endif %}

{% schema %}
{
  "name": "Product delivery date",
  "target": "section",
  "stylesheet": "delivery-widget.css",
  "javascript": "delivery-widget.js",
  "enabled_on": {
    "templates": ["product", "collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Product page only. Use Cart delivery date for the cart."
    }
  ]
}
{% endschema %}
