{% doc %}
Renders the estimated delivery date widget on the cart page only.
{% enddoc %}

{% render "edd-cart-root", shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "Cart delivery date",
  "target": "section",
  "stylesheet": "delivery-widget.css",
  "javascript": "delivery-widget.js",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Cart page only. Use Product delivery date for product pages."
    }
  ]
}
{% endschema %}
