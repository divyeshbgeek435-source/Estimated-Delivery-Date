{% doc %}
Lightweight app embed fallback. Assets load only on product and cart pages.
{% enddoc %}

{% if template.name == "product" or template.name == "cart" %}
  {{ 'delivery-widget.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'delivery-widget.js' | asset_url }}" defer></script>
  <script>
    fetch("/apps/delivery-date/embed-ping", { keepalive: true }).catch(function () {});
  </script>
  {% if template.name == "product" %}
    {% render "edd-product-root", product: product, collection: collection %}
  {% else %}
    {% render "edd-cart-root" %}
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Estimated delivery embed",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows estimated delivery on product and cart pages if the app block is not placed. Prefer Product delivery date and Cart delivery date blocks for exact placement."
    }
  ]
}
{% endschema %}
