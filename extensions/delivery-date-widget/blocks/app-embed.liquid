{% doc %}
App embed that loads estimated delivery scripts and shows the widget when the page block is missing.
{% enddoc %}

<script>
  fetch("/apps/delivery-date/embed-ping", { keepalive: true }).catch(function () {});
</script>

{% if template.name == "product" %}
  {% render "edd-product-root", product: product, collection: collection %}
{% elsif template.name == "collection" %}
  {% render "edd-product-root", collection: collection %}
{% elsif template.name == "cart" %}
  {% render "edd-cart-root" %}
{% endif %}

{% schema %}
{
  "name": "Estimated delivery embed",
  "target": "body",
  "stylesheet": "delivery-widget.css",
  "javascript": "delivery-widget.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Loads scripts and shows the widget if the page block is missing. Use Product delivery date on product pages and Cart delivery date on the cart page to choose placement."
    }
  ]
}
{% endschema %}
