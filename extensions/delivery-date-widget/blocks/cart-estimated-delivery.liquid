{% doc %}
Renders the estimated delivery date widget on the cart page.
{% enddoc %}

{% render "edd-cart-root", shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "Cart estimated delivery",
  "target": "section",
  "stylesheet": "delivery-widget.css",
  "javascript": "delivery-widget.js",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows estimated delivery on the cart page. Saving Publish or Schedule in the app adds this block to the cart page automatically."
    }
  ]
}
{% endschema %}
